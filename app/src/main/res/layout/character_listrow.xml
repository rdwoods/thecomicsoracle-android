<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_character_list_row_layout">

    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/character_thumbnail"
        fresco:placeholderImage="@drawable/default_profile_avatar"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_width="51dp"
        android:layout_height="56dp"
        fresco:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        fresco:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="4dp"
        fresco:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/character_name"
        android:layout_width="300dp"
        android:layout_height="59dp"
        android:textSize="@dimen/character_name_size"
        android:gravity="center"
        android:textColor="@color/black"
        fresco:layout_constraintStart_toEndOf="@+id/character_thumbnail"
        android:layout_marginStart="8dp"
        fresco:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp"
        fresco:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="8dp"
        fresco:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp" />

</android.support.constraint.ConstraintLayout>