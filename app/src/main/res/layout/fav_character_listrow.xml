<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/rl_fav_character_list_row_layout"
    android:paddingTop="@dimen/row_padding">

    <ImageView
        android:id="@+id/fav_character_thumbnail"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:contentDescription="@string/sr_fav_character_thumbnail" />

    <TextView
        android:id="@+id/fav_character_name"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:textSize="@dimen/character_name_size"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_gravity="center_vertical"
        android:layout_alignParentEnd="false"
        android:layout_toEndOf="@+id/fav_character_thumbnail"
        android:layout_alignTop="@+id/fav_character_thumbnail"
        android:layout_alignBottom="@+id/fav_character_thumbnail"/>

</RelativeLayout>